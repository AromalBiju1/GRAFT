# Copy to .env and adjust. Every value below is the default that
# graft.config.Settings uses when the variable is not set, so an empty .env
# behaves identically to no .env.
#
# GRAFT_LOG_LEVEL is read by logging_config, not by Settings:
#   debug - everything, including slow third-party chatter
#   info  - normal operation (default)
#   warning / error - quieter
#
# `.env` is gitignored. Do not commit real API keys.

# --- Logging ---
GRAFT_LOG_LEVEL=info

# --- Server ---
API_HOST=127.0.0.1
# Settings default is 8000. The dev launcher starts at 8001 (the frontend proxy
# default) and moves to the next free port if that one is taken. Uncomment to
# pin a specific port.
# API_PORT=8000
API_RELOAD=true
# Comma-separated CORS origins the API may serve, e.g.
#   CORS_ORIGINS=http://localhost:5173,https://graft.example.org
# Empty or "*" allows every origin (dev/demo behaviour). Per the CORS spec a
# wildcard origin cannot be combined with credentials, so wildcard mode forces
# credentials off; explicit origin lists keep credentialed requests allowed.
CORS_ORIGINS=
# Load the embedding model and open the Chroma collection at startup instead of
# on the first request. Costs ~0.4s of startup to remove a ~0.4s (or worse)
# stall from the first request.
WARMUP_ON_STARTUP=true

# --- Embeddings ---
# sentence-transformers | stub
# "stub" is a deterministic 16-dim hash. Useful offline, but retrieval stops
# being semantic: it will return passages with no relation to the question.
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Vector store ---
CHROMA_PATH=.graft/chroma
# Base name only. The embedder and dimension are appended automatically so
# switching embedder selects a different collection rather than raising a
# dimension mismatch. See embeddings.collection_name().
CHROMA_COLLECTION=graft_tree_nodes

# --- Query logger (SQLite) ---
DB_PATH=db/graft_logs.db

# --- Router thresholds ---
# A query scoring below the simple threshold is treated as simple and searched
# at the leaves only. Tuned by hand; see REMAINING_WORK.md issue 5.
ROUTER_THRESHOLD_SIMPLE=0.35
ROUTER_THRESHOLD_COMPLEX=0.65
DEFAULT_RETRIEVAL_DEPTH=1

# --- LLM answer synthesis (optional) ---
# One-command local stack (API + frontend + llama.cpp):
#   macOS/Linux:        ./scripts/dev.sh
#   Windows PowerShell: .\scripts\dev.ps1
#   Windows cmd:        scripts\dev.bat
#
# gemini | openai | groq | ollama | llamacpp | local
# "local" means inject your own callable; for a local server use ollama or
# llamacpp instead. LLM_ENABLED must be true or /query stays deterministic.
# LLM_ENABLED=true
# LLM_PROVIDER=gemini
# Per-request timeout for Groq/Ollama/llama.cpp. Raise it if a local model
# needs to load on first use.
# LLM_TIMEOUT_SECONDS=120
#
# Gemini / OpenAI (SDKs from `pip install -e ".[llm]"`)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
#
# Groq (OpenAI-compatible; GPT-OSS 120B is the default, but it runs remotely)
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
#
# Ollama (any model you have pulled; 120B is Groq-only)
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.2:3b
#
# llama.cpp / local GGUF. Drop a .gguf in models/ or set any path. This is the
# local model; use whatever file fits your machine, not the Groq 120B model.
# Windows examples:
#   LLAMACPP_MODEL_PATH=C:\models\your-model.gguf
#   LLAMA_SERVER_BIN=C:\tools\llama.cpp\llama-server.exe
# LLAMACPP_BASE_URL=http://127.0.0.1:8081/v1
# LLAMACPP_MODEL=graft-local
# LLAMACPP_MODEL_PATH=models/your-model.gguf
# Optional: custom llama.cpp build (for non-standard quantisation) and extra
# llama-server flags. Quote LLAMACPP_ARGS because the launcher splits it into
# separate arguments; quote any path inside it that contains spaces too.
# LLAMA_SERVER_BIN=llama-server
# LLAMACPP_ARGS="-ngl 99 --jinja --ctx-size 2048"
