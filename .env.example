# Copy to .env and adjust. Every value below is the default that
# graft.config.Settings uses when the variable is not set, so an empty .env
# behaves identically to no .env.
#
# GRAFT_LOG_LEVEL is read by logging_config, not by Settings:
#   debug - everything, including slow third-party chatter
#   info  - normal operation (default)
#   warning / error - quieter
#
# `.env` is gitignored. Do not commit real API keys.

# --- Logging ---
GRAFT_LOG_LEVEL=info

# --- Server ---
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true
# Load the embedding model and open the Chroma collection at startup instead of
# on the first request. Costs ~0.4s of startup to remove a ~0.4s (or worse)
# stall from the first request.
WARMUP_ON_STARTUP=true

# --- Embeddings ---
# sentence-transformers | stub
# "stub" is a deterministic 16-dim hash. Useful offline, but retrieval stops
# being semantic: it will return passages with no relation to the question.
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Vector store ---
CHROMA_PATH=.graft/chroma
# Base name only. The embedder and dimension are appended automatically so
# switching embedder selects a different collection rather than raising a
# dimension mismatch. See embeddings.collection_name().
CHROMA_COLLECTION=graft_tree_nodes

# --- Query logger (SQLite) ---
DB_PATH=db/graft_logs.db

# --- Router thresholds ---
# A query scoring below the simple threshold is treated as simple and searched
# at the leaves only. Tuned by hand; see REMAINING_WORK.md issue 5.
ROUTER_THRESHOLD_SIMPLE=0.35
ROUTER_THRESHOLD_COMPLEX=0.65
DEFAULT_RETRIEVAL_DEPTH=1

# --- LLM answer synthesis (optional) ---
# gemini | openai | local. Leave the provider unset and synthesis stays
# deterministic with no network call.
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini