# GRAFT environment configuration
# Copy to .env and fill in real values — never commit .env itself.

# --- LLM provider ---
# Choose one: gemini, openai, local
GRAFT_LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Embeddings ---
# Choose one: sentence-transformers, gemini, openai
GRAFT_EMBEDDING_PROVIDER=sentence-transformers
GRAFT_EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Vector store ---
GRAFT_CHROMA_PATH=.graft/chroma
GRAFT_CHROMA_COLLECTION=graft_tree_nodes

# --- SQLite logger ---
GRAFT_DB_PATH=db/graft_logs.db

# --- API ---
GRAFT_API_HOST=127.0.0.1
GRAFT_API_PORT=8000
GRAFT_API_RELOAD=true

# --- Retrieval / Router tuning ---
GRAFT_DEFAULT_RETRIEVAL_DEPTH=1
GRAFT_ROUTER_THRESHOLD_SIMPLE=0.35
GRAFT_ROUTER_THRESHOLD_COMPLEX=0.65
